{
  "name": "scrollix-blueprint",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build",
    "check": "npm run typecheck && npm run test && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "check:all": "npm run check && npm run test:e2e"
  },
  "dependencies": {
    "three": "0.176.0"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/three": "0.176.0",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vite": "7.3.5",
    "vitest": "3.2.6"
  }
}
